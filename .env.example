# Sub2API image version. Update this value deliberately and commit the change.
SUB2API_VERSION=0.1.169

# The official image's latest stable release. Pin a version here if desired.
TAILSCALE_VERSION=latest
TAILSCALE_HOSTNAME=sub2api

# Optional unattended first start: use an untagged, one-off, non-ephemeral auth key.
# Leave blank for browser authorization. Clear after joining; state persists locally.
TS_AUTHKEY=

BIND_HOST=0.0.0.0
SERVER_PORT=18080
RUN_MODE=standard
TZ=Asia/Shanghai

POSTGRES_USER=sub2api
POSTGRES_PASSWORD=
POSTGRES_DB=sub2api
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10

REDIS_PASSWORD=

ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=

JWT_SECRET=
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=

# Optional proxy used by Sub2API when accessing GitHub.
UPDATE_PROXY_URL=
