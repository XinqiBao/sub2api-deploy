{
  "TCP": {
    "80": {
      "HTTP": true
    },
    "443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:80": {
      "Handlers": {
        "/": {
          "Redirect": "308:https://${TS_CERT_DOMAIN}${REQUEST_URI}"
        }
      }
    },
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://sub2api:8080"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": false
  }
}
